# Kopiere diese Datei als .env neben die Compose-Datei und passe die Werte an (REQ-041).
# Ohne .env gelten die Werte hinter dem Gleichheitszeichen in den Compose-Dateien.

# Port, unter dem die App auf dem Rechner oder Server erreichbar ist.
DROHNENVERWALTUNG_PORT=8080

# Image fuer docker-compose.server.yml, zum Beispiel eine feste Version statt latest:
# DROHNENVERWALTUNG_IMAGE=ghcr.io/antongschwendtner/drohnenverwaltung:sha-1a2b3c4
